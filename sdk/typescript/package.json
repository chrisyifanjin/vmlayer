{
  "name": "vmlayer",
  "version": "0.1.0",
  "description": "The layer between agent runtimes and microVMs: one sandbox API over Firecracker and Docker (libkrun planned).",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "https://github.com/chrisyifanjin/vmlayer", "directory": "sdk/typescript" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "proto", "README.md"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "lint": "eslint src tests && prettier --check src tests",
    "format": "prettier --write src tests",
    "sync-proto": "rm -rf proto && cp -R ../../proto ./proto"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.0",
    "@grpc/proto-loader": "^0.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.73.0"
  }
}
